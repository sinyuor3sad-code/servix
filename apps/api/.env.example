# V-29: <REQUIRED_NO_DEFAULT> placeholders are rejected by Joi at boot.
# Generate real secrets with `openssl rand -base64 48` before running the API.
NODE_ENV=development
PORT=4000

# Database
PLATFORM_DATABASE_URL=postgresql://servix:<REQUIRED_NO_DEFAULT>@localhost:5432/servix_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (min 64 chars, see V-30 — env.validation.ts enforces this)
JWT_ACCESS_SECRET=<REQUIRED_NO_DEFAULT>
JWT_REFRESH_SECRET=<REQUIRED_NO_DEFAULT>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# V-01 — WebSocket handshake enforcement. Secure-by-default. Set to
# "false" only during a short staged-rollout window to observe legacy
# (un-authenticated) clients before flipping back to "true".
WS_AUTH_ENFORCE=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://app.servi-x.com,https://booking.servi-x.com,https://admin.servi-x.com,https://servi-x.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Storage (MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=servix_minio
S3_SECRET_KEY=<REQUIRED_NO_DEFAULT>
S3_BUCKET=servix-uploads

# Email (placeholder)
MAIL_API_KEY=
MAIL_FROM=noreply@servi-x.com

# SMS (placeholder)
SMS_API_KEY=
SMS_SENDER_ID=SERVIX

# WhatsApp
# NOTE: WhatsApp credentials are stored PER-TENANT in the tenant database settings table.
# Do NOT configure WhatsApp credentials here. Each salon connects their own WhatsApp Business account.

# Sentry (error tracking — leave empty to disable)
SENTRY_DSN=

# AI — Gemini (leave empty to disable AI features)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# WhatsApp Webhook — Verify token for Meta webhook validation
# Must match what you enter in Meta Business → WhatsApp → Configuration → Webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<REQUIRED_NO_DEFAULT>
