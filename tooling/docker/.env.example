# ══════════════════════════════════════════════
# SERVIX — Production Environment Variables
# ══════════════════════════════════════════════
# Copy this file to .env and fill in all values
# DO NOT commit the .env file to version control!
#
# V-29: every <REQUIRED_NO_DEFAULT> must be replaced before deploy.
# The API's Joi schema (env.validation.ts) rejects any value still containing
# this marker or `change-me`/`CHANGE_ME`. Generate with:
#   openssl rand -base64 48           # for JWT_*_SECRET (min 64 chars)
#   openssl rand -hex 32              # for ENCRYPTION_KEY (64 hex chars)
#   openssl rand -base64 32           # for everything else

# ── PostgreSQL ──
POSTGRES_USER=servix
POSTGRES_PASSWORD=<REQUIRED_NO_DEFAULT>
POSTGRES_DB=servix_platform
POSTGRES_PORT=5432

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<REQUIRED_NO_DEFAULT>

# ── MinIO (Object Storage / Backups) ──
MINIO_ROOT_USER=servix_minio
MINIO_ROOT_PASSWORD=<REQUIRED_NO_DEFAULT>

# ── JWT Authentication (V-30: min 64 chars) ──
JWT_ACCESS_SECRET=<REQUIRED_NO_DEFAULT>
JWT_REFRESH_SECRET=<REQUIRED_NO_DEFAULT>

# ── Encryption (V-30: 64 hex chars = 32-byte AES-256 key) ──
ENCRYPTION_KEY=<REQUIRED_NO_DEFAULT>

# ── Backup ──
BACKUP_ENCRYPTION_PASSPHRASE=<REQUIRED_NO_DEFAULT>

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=https://app.servi-x.com,https://booking.servi-x.com,https://admin.servi-x.com,https://servi-x.com

# ── Public URLs ──
API_URL=https://api.servi-x.com/api/v1
WS_URL=https://api.servi-x.com
NEXT_PUBLIC_BOOKING_URL=https://booking.servi-x.com
NEXT_PUBLIC_DASHBOARD_URL=https://app.servi-x.com

# ── Sentry (Error Tracking — optional) ──
SENTRY_DSN=

# ── Google Gemini AI (optional) ──
GEMINI_API_KEY=

# ── Cloudflare AI (optional) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# ── WhatsApp Business API (optional) ──
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_REGISTRATION_PIN=
META_APP_ID=
META_APP_SECRET=

# ── Grafana ──
GRAFANA_PASSWORD=<REQUIRED_NO_DEFAULT>

# ── Vault (optional — for secrets management) ──
VAULT_TOKEN=

# ── Replication (optional — for read replica) ──
REPLICATION_PASSWORD=

# ── Off-site Backup (optional — S3-compatible) ──
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_REGION=us-east-1

# ── Alerting (optional) ──
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
