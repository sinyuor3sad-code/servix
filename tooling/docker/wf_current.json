[{"updatedAt":"2026-04-23T03:58:37.769Z","createdAt":"2026-04-23T03:58:07.709Z","id":"wf-servix-ai-reception-0005","name":"Servix — AI Reception (5-Provider Fallback)","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"servix-ai-reception","responseMode":"responseNode","options":{}},"id":"n8n-node-webhook","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[200,400],"webhookId":"servix-ai-reception"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"guard-tenantId","leftValue":"={{ $json.body.tenantId }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}},{"id":"guard-phone","leftValue":"={{ $json.body.phone }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}},{"id":"guard-message","leftValue":"={{ $json.body.message }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"},"options":{}},"id":"n8n-node-validate","name":"Validate Payload","type":"n8n-nodes-base.if","typeVersion":2,"position":[420,400]},{"parameters":{"jsCode":"// Build unified prompt from input payload\nconst body = $input.first().json.body;\nconst ctx = body.salonContext || {};\nconst history = (body.history || []).slice(-8);\nconst tone = body.tone || 'friendly';\nconst toneText = tone === 'formal' ? 'استخدم لغة رسمية ومهنية' : 'استخدم لغة ودية ودافئة مع إيموجي معتدل';\n\nconst systemPrompt = body.systemPrompt || `أنت موظف استقبال ذكي في \"${ctx.salonName || 'الصالون'}\".\n\n${toneText}\n\nمهامك: الترحيب، عرض الخدمات والأسعار، مساعدة في حجز/إلغاء/تعديل المواعيد، الإجابة على الاستفسارات.\n\nالقواعد:\n- رد باختصار (3-4 أسطر max)\n- لو العميل يتكلم إنجليزي رد إنجليزي\n- لا تختلق معلومات\n- لا تذكر أنك AI أو بوت\n- العملة: ريال سعودي (ر.س)\n- لا تؤكد أي حجز/إلغاء — أنشئ proposedAction فقط\n- لو نقصت معلومة (خدمة/تاريخ/وقت) اطلبها ولا تنشئ proposedAction\n\n⚠️ رد بصيغة JSON فقط:\n{\n  \"intent\": \"greeting | inquiry | book_appointment | cancel_appointment | reschedule | complaint | other\",\n  \"reply\": \"الرد النصي للعميل\",\n  \"proposedAction\": null أو {\n    \"type\": \"book_appointment | cancel_appointment | reschedule\",\n    \"payload\": { \"serviceName\": \"...\", \"date\": \"...\", \"time\": \"...\", \"clientName\": \"...\" }\n  }\n}\n\nبيانات الصالون:\n- الاسم: ${ctx.salonName || 'غير محدد'}\n- ساعات العمل: ${ctx.workingHours || 'غير محدد'}\n- الخدمات: ${JSON.stringify(ctx.services || [])}\n- الموظفين: ${JSON.stringify(ctx.employees || [])}\n${ctx.clientInfo ? '- العميل: ' + ctx.clientInfo.name + ' (' + ctx.clientInfo.visits + ' زيارة)' : '- عميل جديد'}`;\n\n// Build messages array (OpenAI-compatible format, works for Groq/Cerebras/OpenRouter)\nconst messages = [\n  { role: 'system', content: systemPrompt },\n  ...history.map(h => ({ role: h.role === 'user' ? 'user' : 'assistant', content: h.text })),\n  { role: 'user', content: body.message }\n];\n\n// Build Gemini-format contents\nconst geminiContents = [\n  { role: 'user', parts: [{ text: systemPrompt }] },\n  { role: 'model', parts: [{ text: 'فهمت، أنا جاهز.' }] },\n  ...history.map(h => ({ role: h.role === 'user' ? 'user' : 'model', parts: [{ text: h.text }] })),\n  { role: 'user', parts: [{ text: body.message }] }\n];\n\nreturn [{\n  json: {\n    messages,\n    geminiContents,\n    systemPrompt,\n    originalBody: body\n  }\n}];"},"id":"n8n-node-build-prompt","name":"Build Prompt","type":"n8n-nodes-base.code","typeVersion":2,"position":[640,320]},{"parameters":{"method":"POST","url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key={{$credentials.geminiApiKey}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"contents\": {{ JSON.stringify($json.geminiContents) }},\n  \"generationConfig\": {\n    \"temperature\": 0.4,\n    \"maxOutputTokens\": 800,\n    \"responseMimeType\": \"application/json\"\n  }\n}","options":{"timeout":15000},"authentication":"genericCredentialType","genericAuthType":"httpQueryAuth"},"id":"n8n-node-gemini","name":"[1] Google Gemini","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[900,120],"onError":"continueErrorOutput","continueOnFail":true,"credentials":{"httpQueryAuth":{"id":"cred-gemini-004","name":"Gemini API"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"check-gemini-ok","leftValue":"={{ $json.candidates?.[0]?.content?.parts?.[0]?.text }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"},"options":{}},"id":"n8n-node-gemini-check","name":"Gemini OK?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1120,120]},{"parameters":{"method":"POST","url":"https://api.groq.com/openai/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": {{ JSON.stringify($('Build Prompt').first().json.messages) }},\n  \"max_tokens\": 800,\n  \"temperature\": 0.4\n}","options":{"timeout":15000}},"id":"n8n-node-groq","name":"[2] Groq","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1340,260],"onError":"continueErrorOutput","continueOnFail":true,"credentials":{"httpHeaderAuth":{"id":"cred-groq-001","name":"Groq API"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"check-groq-ok","leftValue":"={{ $json.choices?.[0]?.message?.content }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"},"options":{}},"id":"n8n-node-groq-check","name":"Groq OK?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1560,260]},{"parameters":{"method":"POST","url":"=https://api.cloudflare.com/client/v4/accounts/{{$credentials.cloudflareAccountId}}/ai/run/@cf/google/gemma-4-26b-a4b-it","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"messages\": {{ JSON.stringify($('Build Prompt').first().json.messages) }},\n  \"max_tokens\": 800\n}","options":{"timeout":15000}},"id":"n8n-node-cloudflare","name":"[3] Cloudflare","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1780,400],"onError":"continueErrorOutput","continueOnFail":true,"credentials":{"httpHeaderAuth":{"id":"cred-groq-001","name":"Groq API"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"check-cf-ok","leftValue":"={{ $json.result?.response }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"},"options":{}},"id":"n8n-node-cf-check","name":"Cloudflare OK?","type":"n8n-nodes-base.if","typeVersion":2,"position":[2000,400]},{"parameters":{"method":"POST","url":"https://api.cerebras.ai/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"llama-3.3-70b\",\n  \"messages\": {{ JSON.stringify($('Build Prompt').first().json.messages) }},\n  \"max_tokens\": 800,\n  \"temperature\": 0.4\n}","options":{"timeout":15000}},"id":"n8n-node-cerebras","name":"[4] Cerebras","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2220,540],"onError":"continueErrorOutput","continueOnFail":true,"credentials":{"httpHeaderAuth":{"id":"cred-cerebras-002","name":"Cerebras API"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"check-cerebras-ok","leftValue":"={{ $json.choices?.[0]?.message?.content }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"},"options":{}},"id":"n8n-node-cerebras-check","name":"Cerebras OK?","type":"n8n-nodes-base.if","typeVersion":2,"position":[2440,540]},{"parameters":{"method":"POST","url":"https://openrouter.ai/api/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"openrouter/auto\",\n  \"messages\": {{ JSON.stringify($('Build Prompt').first().json.messages) }},\n  \"max_tokens\": 800,\n  \"temperature\": 0.4\n}","options":{"timeout":15000}},"id":"n8n-node-openrouter","name":"[5] OpenRouter","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2660,680],"onError":"continueErrorOutput","continueOnFail":true,"credentials":{"httpHeaderAuth":{"id":"cred-openrouter-003","name":"OpenRouter API"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"check-or-ok","leftValue":"={{ $json.choices?.[0]?.message?.content }}","rightValue":"","operator":{"type":"string","operation":"notEmpty"}}],"combinator":"and"},"options":{}},"id":"n8n-node-or-check","name":"OpenRouter OK?","type":"n8n-nodes-base.if","typeVersion":2,"position":[2880,680]},{"parameters":{"jsCode":"// Parse response from whichever provider succeeded\n// This node receives input from the successful provider's output\nconst item = $input.first().json;\nlet rawText = '';\n\n// Detect format: Gemini vs OpenAI-compatible\nif (item.candidates) {\n  // Gemini format\n  rawText = item.candidates?.[0]?.content?.parts?.[0]?.text || '';\n} else if (item.choices) {\n  // OpenAI-compatible (Groq/Cerebras/OpenRouter)\n  rawText = item.choices?.[0]?.message?.content || '';\n} else if (item.result?.response) {\n  // Cloudflare format\n  rawText = item.result.response;\n}\n\nif (!rawText) {\n  return [{ json: { intent: 'error', reply: 'عذراً، لم نتمكن من معالجة طلبك. يرجى المحاولة مرة أخرى. 🙏', proposedAction: null, success: false } }];\n}\n\n// Parse JSON from AI response\ntry {\n  // Try direct JSON parse\n  let parsed;\n  try {\n    parsed = JSON.parse(rawText);\n  } catch {\n    // Try extracting JSON from markdown or text\n    const jsonMatch = rawText.match(/\\{[\\s\\S]*\"intent\"[\\s\\S]*\"reply\"[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      parsed = JSON.parse(jsonMatch[0]);\n    } else {\n      // Treat as plain text reply\n      return [{ json: { intent: 'general_reply', reply: rawText.trim(), proposedAction: null, success: true } }];\n    }\n  }\n  \n  return [{ json: {\n    intent: parsed.intent || 'unknown',\n    reply: parsed.reply || rawText,\n    proposedAction: parsed.proposedAction || null,\n    success: true\n  }}];\n} catch (err) {\n  return [{ json: { intent: 'general_reply', reply: rawText.trim(), proposedAction: null, success: true } }];\n}"},"id":"n8n-node-parse","name":"Parse AI Response","type":"n8n-nodes-base.code","typeVersion":2,"position":[3200,400]},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.stringify($json) }}"},"id":"n8n-node-respond-ok","name":"Respond OK","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[3420,400]},{"parameters":{"respondWith":"json","responseCode":400,"responseBody":"={ \"success\": false, \"error\": \"missing required fields: tenantId, phone, message\" }"},"id":"n8n-node-respond-bad","name":"Respond Bad Request","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[640,500]},{"parameters":{"respondWith":"json","responseBody":"={ \"intent\": \"error\", \"reply\": \"مرحباً! نعتذر عن التأخير — يمكنك التواصل مع الصالون مباشرة. 🙏\", \"proposedAction\": null, \"success\": false }"},"id":"n8n-node-respond-fallback","name":"All Failed — Fallback","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[3100,760]}],"connections":{"Webhook":{"main":[[{"node":"Validate Payload","type":"main","index":0}]]},"Groq OK?":{"main":[[{"node":"Parse AI Response","type":"main","index":0}],[{"node":"[3] Cloudflare","type":"main","index":0}]]},"[2] Groq":{"main":[[{"node":"Groq OK?","type":"main","index":0}],[{"node":"[3] Cloudflare","type":"main","index":0}]]},"Gemini OK?":{"main":[[{"node":"Parse AI Response","type":"main","index":0}],[{"node":"[2] Groq","type":"main","index":0}]]},"Build Prompt":{"main":[[{"node":"[1] Google Gemini","type":"main","index":0}]]},"Cerebras OK?":{"main":[[{"node":"Parse AI Response","type":"main","index":0}],[{"node":"[5] OpenRouter","type":"main","index":0}]]},"[4] Cerebras":{"main":[[{"node":"Cerebras OK?","type":"main","index":0}],[{"node":"[5] OpenRouter","type":"main","index":0}]]},"Cloudflare OK?":{"main":[[{"node":"Parse AI Response","type":"main","index":0}],[{"node":"[4] Cerebras","type":"main","index":0}]]},"OpenRouter OK?":{"main":[[{"node":"Parse AI Response","type":"main","index":0}],[{"node":"All Failed — Fallback","type":"main","index":0}]]},"[3] Cloudflare":{"main":[[{"node":"Cloudflare OK?","type":"main","index":0}],[{"node":"[4] Cerebras","type":"main","index":0}]]},"[5] OpenRouter":{"main":[[{"node":"OpenRouter OK?","type":"main","index":0}],[{"node":"All Failed — Fallback","type":"main","index":0}]]},"Validate Payload":{"main":[[{"node":"Build Prompt","type":"main","index":0}],[{"node":"Respond Bad Request","type":"main","index":0}]]},"Parse AI Response":{"main":[[{"node":"Respond OK","type":"main","index":0}]]},"[1] Google Gemini":{"main":[[{"node":"Gemini OK?","type":"main","index":0}],[{"node":"[2] Groq","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","saveDataErrorExecution":"all","saveExecutionProgress":true,"timezone":"Asia/Riyadh"},"staticData":null,"meta":{"templateId":"servix-ai-reception-v2"},"pinData":{},"versionId":"c8b988b6-75b4-4c47-b3f6-53a7d121ef41","activeVersionId":"c8b988b6-75b4-4c47-b3f6-53a7d121ef41","versionCounter":15,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-04-23T03:58:07.709Z","createdAt":"2026-04-23T03:58:07.709Z","role":"workflow:owner","workflowId":"wf-servix-ai-reception-0005","pr